# Copier en .env (ignoré par git). Lu par le Makefile.
# Aucun secret ici : le token GitHub vit dans Secret Manager.

# Compte GCP du projet (perso). Les scripts refusent de tourner avec un autre compte.
# gcloud utilise une config isolée (~/.config/gcloud-platform-ai-demo, cf. Makefile) :
# la config gcloud globale de la machine (ex. compte client) n'est jamais utilisée.
GCP_ACCOUNT=me@example.com

# Projet GCP cible
GCP_PROJECT_ID=my-gcp-project
GCP_REGION=europe-west4
GCP_ZONE=europe-west4-a

# Compte de facturation portant le budget (make bootstrap)
GCP_BILLING_ACCOUNT_ID=000000-000000-000000
BUDGET_AMOUNT=50
BUDGET_CURRENCY=EUR
