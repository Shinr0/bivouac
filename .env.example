# Copier en .env (ignoré par git). Lu par le Makefile.
# Aucun secret ici : le token GitHub vit dans Secret Manager.

# Projet GCP cible
GCP_PROJECT_ID=my-gcp-project
GCP_REGION=europe-west4
GCP_ZONE=europe-west4-a

# Compte de facturation portant le budget (make bootstrap)
GCP_BILLING_ACCOUNT_ID=000000-000000-000000
BUDGET_AMOUNT=50
BUDGET_CURRENCY=EUR
